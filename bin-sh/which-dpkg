for name in "$@"
do
	if   [ -e "${name}" ]
	then
		dpkg-query --search "${name}"
	elif filepath=$(which "${name}" 2>/dev/null)
	then
		dpkg-query --search "${filepath}"
	elif [ -e "/sbin/${name}" ]
	then
		dpkg-query --search "/sbin/${name}"
	elif [ -e "/usr/sbin/${name}" ]
	then
		dpkg-query --search "/usr/sbin/${name}"
	else
		echo "${name} not found" > /dev/stderr
	fi
done
