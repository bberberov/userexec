# Works up to a depth of 12 indentations

usage() {
echo '
Convert tabs to spaces or vice-versa

filter-indent <option>

Options:
    --1sp-to-tab
    --2sp-to-tab
    --4sp-to-tab
    --8sp-to-tab
    --tab-to-1sp
    --tab-to-2sp
    --tab-to-4sp
    --tab-to-8sp
    --help
    -?
'
}

