mkfs.xfs "$@" \
| sed -E -e $'
	1{
		s/^Parameters parsed from config file /&\e[1m/
		s/ successfully$/\e[0m&/
	}
	2{
		/^meta-data=/i
	}
	${
		/^Parameters parsed from config file /i
	}

	/(data     |naming   |log      |realtime )=/i

	/meta-data=/{
		s@/dev/[[:graph:]]+@\e[93m&\e[0m@

		s/isize=([0-9]+)/\e[36mi\e[90msize\e[0m=\e[36m\\1\e[0m/
		s/agcount=([0-9]+)/\e[33mag\e[90mcount\e[0m=\e[33m\\1\e[0m/
		s/agsize=([0-9]+)/\e[33mag\e[90msize\e[0m=\e[93m\\1\e[0m/
	}
	/naming   =/{
		s@version [[:graph:]]+@\e[34m&\e[0m@

		# Deprecated (version=ci)
		s/(ascii-ci)=1/\e[31m\\1\e[0m=\e[31m1\e[0m/g
		s/(ascii-ci)=0/\e[32m\\1\e[0m=\e[32m0\e[0m/g
	}
	/log      =/{
		s@internal log@\e[34m&\e[0m@
		s@/dev/[[:graph:]]+@\e[93m&\e[0m@

		# V4 boolean options
		s/(version)=1/\e[31m\\1\e[0m=\e[31m1\e[0m/g
		s/(version)=2/\e[32m\\1\e[0m=\e[32m2\e[0m/g
	}
	/realtime =/{
		s@none@\e[31m&\e[0m@
		s@/dev/[[:graph:]]+@\e[93m&\e[0m@
	}

	# Sector-sized options
	s/sectsz=([0-9]+)/\e[94msect\e[90msz\e[0m=\e[94m\\1\e[0m/

	s/crc=0   /\e[91mcrc\e[0m=\e[91m0\e[0m \e[95mv4\e[0m/
	s/crc=1   /\e[92mcrc\e[0m=\e[92m1\e[0m \e[95mv5\e[0m/

	# Boolean options
	s/(bigtime|finobt|inobtcount|metadir|rmapbt|reflink|sparse|nrext64|exchange|parent)=0/\e[91m\\1\e[0m=\e[91m0\e[0m/g
	s/(bigtime|finobt|inobtcount|metadir|rmapbt|reflink|sparse|nrext64|exchange|parent)=1/\e[92m\\1\e[0m=\e[92m1\e[0m/g

	# V4 boolean options
	s/(projid32bit|lazy-count|ftype)=0/\e[31m\\1\e[0m=\e[31m0\e[0m/g
	s/(projid32bit|lazy-count|ftype)=1/\e[32m\\1\e[0m=\e[32m1\e[0m/g
	s/(attr)=1/\e[31m\\1\e[0m=\e[31m1\e[0m/g
	s/(attr)=2/\e[32m\\1\e[0m=\e[32m2\e[0m/g

	# Block-sized options
	s/bsize=([0-9]+)/\e[93mb\e[90msize\e[0m=\e[93m\\1\e[0m/g
	s/(blocks|sunit|swidth)=([0-9]+)/\e[90m\\1\e[0m=\e[93m\\2\e[0m/g

	# Percent options
	s/imaxpct=([0-9]+)/\e[36mi\e[90mmaxpct\e[0m=\\1 %/

	s/ blks/ \e[93mblocks\e[0m/
'
