for name in "$@"
do
	if   [ -e "${name}" ]
	then
		if   [ 1 -lt $# ]
		then
			printf '%s:\t' "${name}"
		fi

		rpm -qf "${name}"
	elif filepath=$(which "${name}" 2>/dev/null)
	then
		if   [ 1 -lt $# ]
		then
			printf '%s:\t' "${filepath}"
		fi

		rpm -qf "${filepath}"
	else
		echo "${name} not found" > /dev/stderr
	fi
done
