for cmd in \
	curl \
	sed \
;
do
	if   ! which "${cmd}" > /dev/null 2>&1
	then
		echo -e "\e[1;31mERROR: ${cmd} command is not available\e[0m" > /dev/stderr
		exit 1
	fi
done

dir="${1:-${USER_STORE_MIRROR_IMAGES:-.}}"

dll="$(curl --silent 'https://sourceforge.net/projects/gparted/rss?path=/gparted-live-stable' | sed -n -E -e '/      <link>/{ /\/source\//{ d; b; }; s/(      |\/download)<[^<>]*>//gp }')"

# shellcheck disable=SC2086
wget -N \
	-P "${dir}/GPartedLive" \
	${dll}
