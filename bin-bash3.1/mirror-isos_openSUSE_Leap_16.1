dir="${1:-${USER_STORE_MIRROR_IMAGES:-.}}"

user_mirror_file="${XDG_CONFIG_DIR:-${HOME}/.config}/user_mirrors/openSUSE_Leap_16.1"
# shellcheck disable=SC2162
[[ -r "${user_mirror_file}" ]] && read user_mirror < "${user_mirror_file}"

mirror="${2:-${user_mirror:-https://download.opensuse.org}}"

dll="${mirror}/distribution/leap/16.1/offline/"

# shellcheck disable=SC2086
wget -r -l 1 -np -N -e robots=off \
	-e 'dot_bytes = 16m' \
	-e 'dot_spacing = 8' \
	-e 'dots_in_line = 64' \
	-P "${dir}/openSUSE/Leap/16.1" \
	-nd \
	--reject-regex 'C=|/Changes\.|-x86_64\.install\.iso|-aarch64[-.]|-ppc64le[-.]|-s390x[-.]' \
	-R '*.html' \
	-R '*.html.tmp' \
	-R '*.mirrorlist' \
	-R '*.iso' \
	${dll}
