dll="$(curl --silent 'https://sourceforge.net/projects/clonezilla/rss?path=/clonezilla_live_alternative' | sed -n -E -e '/      <link>/{ /\/source\//{ d; b; }; s/(      |\/download)<[^<>]*>//gp }' | head -2)"

