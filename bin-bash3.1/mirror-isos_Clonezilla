for cmd in \
	curl \
	sed \
;
do
	if   ! which "${cmd}" > /dev/null 2>&1
	then
		echo -e "\e[1;31mERROR: ${cmd} command is not available\e[0m" > /dev/stderr
		exit 1
	fi
done

dir="${1:-${USER_STORE_MIRROR_IMAGES:-.}}"

dll="$(curl --silent 'https://sourceforge.net/projects/clonezilla/rss?path=/clonezilla_live_stable' | sed -n -E -e '/      <link>/{ /\/source\//{ d; b; }; s/(      |\/download)<[^<>]*>//gp }' | head -2)"

# shellcheck disable=SC2086
wget -N \
	-e 'dot_bytes = 4m' \
	-e 'dot_spacing = 8' \
	-e 'dots_in_line = 64' \
	-P "${dir}/Clonezilla/stable" \
	${dll}

dll="$(curl --silent 'https://sourceforge.net/projects/clonezilla/rss?path=/clonezilla_live_testing' | sed -n -E -e '/      <link>/{ /\/source\//{ d; b; }; s/(      |\/download)<[^<>]*>//gp }' | head -2)"

