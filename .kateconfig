kate-wildcard(bash-completion/*): syntax Bash;
kate-wildcard(bin-sh/*): syntax Bash;
kate-wildcard(bin-bash/*): syntax Bash;
kate-wildcard(bin-bash?/*): syntax Bash;
kate-wildcard(bin-bash?.?/*): syntax Bash;

kate-wildcard(bin-python3/*): syntax Python;

kate-wildcard(init.bashrc): syntax Bash;
kate-wildcard(init.profile): syntax Bash;
