function usage() {
echo '
Show the extended status of multiple repositories and/or trees

git global-status [options]... [repo_path]...

Options:
    --origin    List by "origin" remote location
    --path      List by full repository/worktree path
    --repo      List by shortened repository path
    --worktree  List by shortened worktree path
    --no-ab     No ahead/behind
    --bare      Show repositories without any worktrees
    --status    Show status information
    --stash     Show existing stashes
    --upstream  Show commit counts relative to UPSTREAM_HEAD symbolic reference
'
}

declare -a src_dirs
declare -a repos
declare -a unique_repos
declare -a worktrees
opt_disppath='' # origin, path, git-dir, repo, worktree
opt_ab='true'
opt_bare='false'
opt_status='false'
opt_stash='false'
opt_upstream='false'
opt_untracked='true'
opt_ignored='true'
opt_inline='true'
max_repo_length=0
max_repo_s_length=0
max_worktree_length=0
max_worktree_s_length=0
columns="$(tput cols)"

git_c_added="$(git config get --type=color --default='green' color.status.added)"
git_c_chged="$(git config get --type=color --default='yellow' color.status.changed)"
git_c_untrk="$(git config get --type=color --default='red' color.status.untracked)"
# NOTE: unofficial configuration
git_c_upmod="$(git config get --type=color --default="cyan" color.status.both)"
git_c_ignrd="$(git config get --type=color --default="$(git config get --no-type --default='red' color.status.untracked)" color.status.ignored)"
git_c_ahead="$(git config get --type=color --default='brightmagenta' color.status.ahead)"
git_c_bhind="$(git config get --type=color --default='brightyellow' color.status.behind)"
git_c_nsync="$(git config get --type=color --default='brightblue' color.status.up-to-date)"

git_c_currn="$(git config get --type=color --default='green' color.branch.current)"
git_c_local="$(git config get --type=color --default='green' color.branch.local)"
git_c_upstr="$(git config get --type=color --default='blue' color.branch.upstream)"
git_c_workt="$(git config get --type=color --default='cyan' color.branch.worktree)"
git_c_plain="$(git config get --type=color --default='bold' color.branch.plain)"

git_c_stash="$(git config get --type=color --default='magenta' color.decorate.stash)"


for opt in "$@"
do
	case "${opt}" in
		--origin)
			opt_disppath='origin'
		;;
		--path)
			opt_disppath='path'
		;;
		--repo)
			opt_disppath='repo'
		;;
		--worktree)
			opt_disppath='worktree'
		;;
		--no-ab)
			opt_ab='false'
		;;
		--bare)
			opt_bare='true'
		;;
		--status)
			opt_status='true'
		;;
		--stash)
			opt_stash='true'
		;;
		--upstream)
			opt_upstream='true'
		;;
		--no-untracked)
			opt_untracked='false'
		;;
		--no-ignored)
			opt_ignored='false'
		;;
		--multiline)
			opt_inline='false'
		;;
		--help | -?)
			usage
			exit 0
		;;
		*)
			if   [[ -d "${opt}" ]]
			then
				# Standardize src_path
				src_dirs+=("$(realpath "${opt}")")
			else
				echo -e "\
\e[1;31mERROR: Unknown option or invalid path: ${opt}\e[0m

Use --help to see the available options"\
					> '/dev/stderr'
				exit 1
			fi
		;;
	esac
done

setup_tabs()
{
	local opt_disppath="${1}"
	local tgt_type="${2}"

	local extra_tabs='+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8,+8'

	if   [[ 'true' == "${opt_inline}" ]]
	then
		case "${opt_disppath}" in
			origin)
				tabs $(( 8 < columns / 3 ? columns / 3 : 8 )),"${extra_tabs}"
			;;
			path)
				case "${tgt_type}" in
					repo)
						tabs $(( 5 < max_repo_length ? max_repo_length + 3 : 8 )),"${extra_tabs}"
					;;
					worktree)
						tabs $(( 5 < max_worktree_length ? max_worktree_length + 3 : 8 )),"${extra_tabs}"
					;;
				esac
			;;
			repo)
				tabs $(( 5 < max_repo_s_length ? max_repo_s_length + 3 : 8 )),"${extra_tabs}"
			;;
			worktree)
				tabs $(( 5 < max_worktree_s_length ? max_worktree_s_length + 3 : 8 )),"${extra_tabs}"
			;;
			*)
				echo "Invalid parameter at ${LINENO}" > '/dev/stderr'
				exit 1
			;;
		esac
	fi
}

inliner()
{
	if   [[ 'true' == "${opt_inline}" ]]
	then
		echo -ne ';\t'
	else
		echo -ne '\n\t'
	fi
}

ahead_behind()
{
	local cur_ref="${1}"
	local tgt_ref="${2}"

	ahead=$(git rev-list --count "${tgt_ref}..${cur_ref}")
	behind=$(git rev-list --count "${cur_ref}..${tgt_ref}")

	if   (( 0 < ahead + behind ))
	then
		if   (( 0 < ahead ))
		then
			echo -ne "${git_c_ahead}${ahead} ahead\e[0m"

			(( 0 < behind )) &&	echo -ne ' '
		fi
		if   (( 0 < behind ))
		then
			echo -ne "${git_c_bhind}${behind} behind\e[0m"
		fi
	else
		echo -ne "${git_c_nsync}up to date\e[0m"
	fi
}

tracking_ab()
{
	local cur_ref="${1}"

	ups_ref="$(git rev-parse --abbrev-ref -q --verify --end-of-options "${cur_ref}"'@{upstream}')"
	if   [[ -n "${ups_ref}" ]]
	then
		ahead_behind "${cur_ref}" "${ups_ref}"
	else
		echo -n 'not tracking'
	fi
}

ref_ab()
{
	local cur_ref="${1}"
	local tgt_ref="${2}"

	ups_ref="$(git rev-parse --abbrev-ref -q --verify --end-of-options "${tgt_ref}")"
	if   [[ -n "${ups_ref}" ]]
	then
		ahead_behind "${cur_ref}" "${ups_ref}"
		echo -n " with ${tgt_ref}"
	else
		echo -n "no ${tgt_ref}"
	fi
}

tree_status()
{
	if   [[ 'true' == "${opt_untracked}" ]]
	then
		untracked_param='--untracked-files=all'
	else
		untracked_param='--untracked-files=no'
	fi

	if   [[ 'true' == "${opt_ignored}" ]]
	then
		ignored_param='--ignored=traditional'
	else
		ignored_param='--ignored=no'
	fi

	status="$(git status "${untracked_param}" "${ignored_param}" --porcelain)"

	status_indx="$(grep -G -c   '^[^ ][ ]'    <<< "${status}")"
	status_tree="$(grep -G -c    '^[ ][^ ]'   <<< "${status}")"
	status_both="$(grep -G -c '^[^ ?!][^ ?!]' <<< "${status}")"
	status_untr="$(grep -G -c      '^??'      <<< "${status}")"
	status_ignr="$(grep -G -c      '^!!'      <<< "${status}")"

	status_all=$(( status_both + status_indx + status_tree + status_untr + status_ignr ))

	separate=0

	if   (( 0 < status_all ))
	then
		inliner

		if   (( 0 < status_both ))
		then
			echo -ne "${git_c_upmod}${status_both} stage+mod\e[0m"

			separate=1
		fi
		if   (( 0 < status_indx ))
		then
			(( 0 < separate )) && echo -n ' '

			echo -ne "${git_c_added}${status_indx} staged\e[0m"

			separate=1
		fi
		if   (( 0 < status_tree ))
		then
			(( 0 < separate )) && echo -n ' '

			echo -ne "${git_c_chged}${status_tree} modified\e[0m"

			separate=1
		fi
		if   (( 0 < status_untr ))
		then
			(( 0 < separate )) && echo -n ' '

			echo -ne "${git_c_untrk}${status_untr} untracked\e[0m"

			separate=1
		fi
		if   (( 0 < status_ignr ))
		then
			(( 0 < separate )) && echo -n ' '

			echo -ne "${git_c_ignrd}${status_ignr} ignored\e[0m"
		fi

		if   (( 1 == status_all ))
		then
			echo -n ' file'
		elif (( 1 <  status_all ))
		then
			echo -n ' files'
		fi
	fi
}

process_worktree()
{
	repo_path="${1}"
	worktree="${2}"
	display="${3}"
	tgt_path="${4}"

	if   [[ -n "${worktree}" ]]
	then
		pushd "${worktree}"  > '/dev/null' || exit 205
	else
		pushd "${repo_path}" > '/dev/null' || exit 205
	fi

	case "${display}" in
		origin)
			if   git remote | grep '^origin$' > '/dev/null' 2>&1
			then
				disppath="$(git remote get-url origin)"
			else
				repo_shortpath="${worktree#"${src_path}/"}"
				disppath="No \`origin\`; ${repo_shortpath:0:30}..."
			fi
			path_color="${git_c_upstr}"
		;;
		path)
			case ${tgt_path} in
				repo)
					disppath=${repo}
					path_color="${git_c_local}"
				;;
				worktree)
					disppath=${worktree}
					path_color="${git_c_workt}"
				;;
			esac
		;;
		repo)
			disppath="${repo_path#"${src_path}/"}"
			path_color="${git_c_local}"
		;;
		worktree)
			if   [[ -n "${worktree}" ]]
			then
				disppath="${worktree#"${src_path}/"}"
				path_color="${git_c_workt}"
			else
				disppath="${repo_path#"${src_path}/"}"
				path_color="${git_c_local}"
			fi
		;;
		*)
			echo "Invalid parameter at ${LINENO}" > '/dev/stderr'
			exit 1
		;;
	esac

	if   [[ -n "${worktree}" || 'true' == "${opt_bare}" ]]
	then
		# Display tree/repo path
		echo -ne "${path_color}${disppath}\e[0m"

		[[ 'false' == "${opt_inline}" ]] && echo
	fi

	if   [[ -n "${worktree}" ]]
	then
		ref="$(git branch --show-current)"

		if   [[ -n "${ref}" ]]
		then
			echo -ne "\t${git_c_currn}${ref}\e[0m"

			if   [[ 'true' == "${opt_ab}" ]]
			then
				echo -ne ' is '

				tracking_ab "${ref}"
			fi

			if   [[ 'true' == "${opt_upstream}" ]]
			then
				echo -ne ', '

				ref_ab "${ref}" 'refs/UPSTREAM_HEAD'
			fi
		else
			echo -ne "\t${git_c_plain}is detached\e[0m"
		fi

		if   [[ 'true' == "${opt_status}" ]]
		then
			tree_status
		fi

	elif [[ 'true' == "${opt_bare}" ]]
	then
		echo -ne '\thas no worktrees'
	fi

	if   [[ -n "${worktree}" || 'true' == "${opt_bare}" ]]
	then
		if   [[ 'true' == "${opt_stash}" ]]
		then
			if   git refs exists 'refs/stash' 2> '/dev/null'
			then
				inliner
				echo -ne "has a ${git_c_stash}stash\e[0m"
			fi
		fi

		# Final newline
		echo
	fi

	popd > '/dev/null' || exit 205
}

pushd . > '/dev/null'
for src_path in "${src_dirs[@]}"
do
	# BEGIN Find potential repos

	unique_repos=()
	repos=()
	worktrees=()

	echo -e "Looking for \e[1mrepos\e[0m in \e[94m${src_path}\e[0m ..."

	# Repos have an objects and refs subdirectories (the git-daemon repo check equivalent)
	tgt_path="$(find "${src_path}" -type d -name objects -print | sort)"

	for repo_test_refs in ${tgt_path}
	do
		# Set the potential repo path and reuse late
		repo_path="${repo_test_refs%/objects}"

		# Check for a sibling refs directory
		if   [[ -d "${repo_path}/refs" ]]
		then
			repo_shortpath="${repo_path#"${src_path}/"}"
			max_repo_length=$(( max_repo_length <= ${#repo_path} ? ${#repo_path} : max_repo_length ))
			max_repo_s_length=$(( max_repo_s_length <= ${#repo_shortpath} ? ${#repo_shortpath} : max_repo_s_length ))

			unique_repos+=("${repo_path}")

			# Look for worktrees in this repo
			worktree=''

			# Detached worktrees check
			if   [[ -d "${repo_path}/worktrees" ]]
			then
				for worktree_gitdir in $(find "${repo_path}/worktrees" -type f -name gitdir -print | sort)
				do
					tree_gitfile="$(< "${worktree_gitdir}")"
					worktree="${tree_gitfile%/.git}"

					tree_pre_gitdir="$(< "${tree_gitfile}")"

					if   [[ "${tree_pre_gitdir}" =~ ^gitdir:[[:space:]] ]]
					then
						tree_gitdir="${tree_pre_gitdir#gitdir: }"

						if   [[ -d "${tree_gitdir}" ]]
						then
							repos+=("${repo_path}")
							worktrees+=("${worktree}")

							worktree_s="${worktree#"${src_path}/"}"
							max_worktree_length=$(( max_worktree_length <= ${#worktree} ? ${#worktree} : max_worktree_length ))
							max_worktree_s_length=$(( max_worktree_s_length <= ${#worktree_s} ? ${#worktree_s} : max_worktree_s_length ))
						else
							if   [[ 'path' == "${opt_disppath:-repo}" ]]
							then
								disppath="${repo_path}"
							else
								disppath="${repo_shortpath}"
							fi
							echo -e "\e[1;31mRepo\e[0m ${git_c_local}${disppath}\e[0m \e[1;31m has a broken detached worktree\e[0m ${git_c_workt}${worktree}\e[0m"
						fi
					fi
				done
			fi

			# "Main" worktree check
			if [[ "${repo_path}" == "${repo_path%/.git}/.git" ]]
			then
				worktree="${repo_path%/.git}"

				repos+=("${repo_path}")
				worktrees+=("${worktree}")

				worktree_s="${worktree#"${src_path}/"}"
				max_worktree_length=$(( max_worktree_length <= ${#worktree} ? ${#worktree} : max_worktree_length ))
				max_worktree_s_length=$(( max_worktree_s_length <= ${#worktree_s} ? ${#worktree_s} : max_worktree_s_length ))
			fi

			# When no worktrees are found
			if   [[ -z "${worktree}" ]]
			then
				repos+=("${repo_path}")
				worktrees+=('')
			fi
		fi
	done

	setup_tabs "${opt_disppath:-repo}" 'repo'

	for (( n = 0; n < ${#worktrees[@]}; n++ ))
	do
		process_worktree "${repos[n]}" "${worktrees[n]}" "${opt_disppath:-repo}" 'repo'
	done

	# END   Find potential repos

	# BEGIN Find potential detached worktrees

	repos=()
	worktrees=()

	echo -e "Looking for \e[1mdetached worktrees\e[0m in \e[94m${src_path}\e[0m ..."

	# Detached worktrees have a .git file, not directory
	trees_gitfile="$(find "${src_path}" -type f -name .git -print | sort)"

	for tree_gitfile in ${trees_gitfile}
	do
		worktree=${tree_gitfile%/.git}

		tree_pre_gitdir="$(< "${tree_gitfile}")"

		if   [[ "${tree_pre_gitdir}" =~ ^gitdir:[[:space:]] ]]
		then
			tree_gitdir="${tree_pre_gitdir#gitdir: }"

			if   [[ -d "${tree_gitdir}" ]]
			then
				repo_path="$(git -C "${tree_gitdir}" rev-parse --git-common-dir 2> '/dev/null')"

				# Don't list the worktree if it has already been found by the repo search
				for test_repo in "${unique_repos[@]}"
				do
					if   [[ "${test_repo}" == "${repo_path}" ]]
					then
						repo_path=''
						break;
					fi
				done

				if   [[ -n "${repo_path}" ]]
				then
					repos+=("${repo_path}")
					worktrees+=("${worktree}")

					repo_shortpath="${repo_path#"${src_path}/"}"
					max_repo_length=$(( max_repo_length <= ${#repo_path} ? ${#repo_path} : max_repo_length ))
					max_repo_s_length=$(( max_repo_s_length <= ${#repo_shortpath} ? ${#repo_shortpath} : max_repo_s_length ))
					worktree_s="${worktree#"${src_path}/"}"
					max_worktree_length=$(( max_worktree_length <= ${#worktree} ? ${#worktree} : max_worktree_length ))
					max_worktree_s_length=$(( max_worktree_s_length <= ${#worktree_s} ? ${#worktree_s} : max_worktree_s_length ))
				fi
			else
				if   [[ 'path' == "${opt_disppath:-worktree}" ]]
				then
					disppath="${worktree}"
				else
					disppath="${worktree_s}"
				fi
				echo -e "\e[1;31mDetached tree\e[0m ${git_c_workt}${disppath}\e[0m \e[1;31mis invalid\e[0m"
			fi
		fi
	done

	setup_tabs "${opt_disppath:-worktree}" 'worktree'

	for (( n = 0; n < ${#worktrees[@]}; n++ ))
	do
		process_worktree "${repos[n]}" "${worktrees[n]}" "${opt_disppath:-worktree}" 'worktree'
	done

	# END   Find potential detached worktrees
done
popd > '/dev/null' || exit 205

# Restore TABS
tabs "${USER_TABS}"
