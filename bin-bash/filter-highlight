opt_blockdev=0
opt_filesys=0

opt_numbers=0
opt_percents=0
opt_units=0

opt_header=0
opt_box=0

opt_show=0

sedfilter=''

for opt in "$@"
do
	case "${opt}" in
		--blockdev)
			if   (( 0 == opt_blockdev ))
			then
				opt_blockdev=1
				sedfilter="${sedfilter}"$'
s@(^|[[:space:]\u2500-\u257F])(/dev/[hsv]d[a-z][0-9]*)([[:space:]]|$)@\\1\e[93m\\2\e[39m\\3@g
s@(^|[[:space:]\u2500-\u257F])(/dev/sr[0-9]+)([[:space:]]|$)@\\1\e[93m\\2\e[39m\\3@g
s@(^|[[:space:]\u2500-\u257F])(/dev/nvme[0-9]+n[0-9]+p[0-9]+)([[:space:]]|$)@\\1\e[93m\\2\e[39m\\3@g
s@(^|[[:space:]\u2500-\u257F])(/dev/nvme[0-9]+n[0-9]+)([[:space:]]|$)@\\1\e[93m\\2\e[39m\\3@g
s@(^|[[:space:]\u2500-\u257F])(/dev/shm)([[:space:]]|$)@\\1\e[92m\\2\e[39m\\3@g
'
			fi
		;;
		--filesys)
			if   (( 0 == opt_filesys ))
			then
				opt_filesys=1
				sedfilter="${sedfilter}"$'
s/(^|[[:space:]])(bcachefs|btrfs|exfat|ext[234]|f2fs|hfsplusjfs|vfat|udf|xfs|zfs)([[:space:]]|$)/\\1\e[32m\\2\e[39m\\3/g
s/(^|[[:space:]])(tmpfs)([[:space:]]|$)/\\1\e[95m\\2\e[39m\\3/g
s/(^|[[:space:]])(ceph|cifs|coda|nfs)([[:space:]]|$)/\\1\e[96m\\2\e[39m\\3/g
s/(^|[[:space:]])(binfmt_misc|bpf|cgroup2|configfs|debugfs|devpts|devtmpfs|efivarfs|hugetlbfs|proc|securityfs|sysfs)([[:space:]]|$)/\\1\e[31m\\2\e[39m\\3/g
'
			fi
		;;
		--numbers)
			if   (( 0 == opt_numbers ))
			then
				opt_numbers=1
				sedfilter="${sedfilter}"$'
s/(^|[[:space:]])([-0])([[:space:]]|$)/\\1\e[90m\\2\e[39m\\3/g
s/(^|[[:space:]])([0-9]{1,3})([0-9]{3})([[:space:]]|$)/\\1\\2\e[90m\\3\e[39m\\4/g
s/(^|[[:space:]])([0-9]{1,3})([0-9]{3})([0-9]{3})([[:space:]]|$)/\\1\\2\e[90m\\3\e[39m\\4\\5/g
s/(^|[[:space:]])([0-9]{1,3})([0-9]{3})([0-9]{3})([0-9]{3})([[:space:]]|$)/\\1\\2\e[90m\\3\e[39m\\4\e[90m\\5\e[39m\\6/g
s/(^|[[:space:]])([0-9]{1,3})([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{3})([[:space:]]|$)/\\1\\2\e[90m\\3\e[39m\\4\e[90m\\5\e[39m\\6\\7/g
'
			fi
		;;
		--percents)
			if   (( 0 == opt_percents ))
			then
				opt_percents=1
				sedfilter="${sedfilter}"$'
s/(^|[[:space:]])([9][0-9])%([[:space:]]|$)/\\1\e[31m\\2\e[39m%\\3/g
s/(^|[[:space:]])([8][0-9])%([[:space:]]|$)/\\1\e[33m\\2\e[39m%\\3/g
s/(^|[[:space:]])([2-7][0-9])%([[:space:]]|$)/\\1\e[32m\\2\e[39m%\\3/g
s/(^|[[:space:]])([10 ][0-9])%([[:space:]]|$)/\\1\e[35m\\2\e[39m%\\3/g
'
			fi
		;;
		--units)
			if   (( 0 == opt_units ))
			then
				opt_units=1
				sedfilter="${sedfilter}"$'
s/(^|[[:space:]])([0-9.]+)([KMGTPEZYRQ])(B|iB)?([[:space:]]|$)/\\1\\2\e[1;36m\\3\\4\e[22;39m\\5/g
s/(^|[[:space:]])([0-9.]+)([kmgtpezyrq])([[:space:]]|$)/\\1\\2\e[1;34m\\3\e[22;39m\\4/g
'
			fi
		;;
		--header)
			if   (( 0 == opt_header ))
			then
				opt_header=1
				sedfilter="${sedfilter}"$'
1s/^/\e[97;100m/
1s/$/\e[0m/
'
			fi
		;;
		--box)
			if   (( 0 == opt_box ))
			then
				opt_box=1
				sedfilter="${sedfilter}"$'
s/[\u2500-\u257F]/\e[36m&\e[39m/g
'
			fi
		;;
		--show)
			opt_show=1
		;;
	esac
done

if   (( 0 == opt_show ))
then
	sed -E -e "${sedfilter}" < /dev/stdin
else
	echo "${sedfilter}"
fi
