color_filter=$'
/=|:/{
	/^Block size/{
		s/Block size/\e[93mBlock\e[90m size\e[0m/
		s/=([0-9]+)/=\e[93m\\1\e[0m/
	}
	/^Fragment size/{
		s/Fragment size/\e[93mFragment\e[90m size\e[0m/
		s/=([0-9]+)/=\e[93m\\1\e[0m/
	}
	/^Cluster size/{
		s/Cluster size/\e[35mCluster\e[90m size\e[0m/
		s/=([0-9]+)/=\e[35m\\1\e[0m/
	}

	s/[^=:]+/\e[90m&\e[0m/
	s/Stripe width/\e[90m&\e[0m/

	s/=/ = /g
}

s/[0-9]+ inodes/\e[36m&\e[0m/g
s/[0-9]+ blocks|[0-9]+ fragments/\e[93m&\e[0m/g
s/[0-9]+ clusters/\e[35m&\e[0m/g
'

if   [[ -r './mke2fs.conf' ]]
then
	configfile='./mke2fs.conf'
elif [[ -n "${XDG_CONFIG_HOME}" && -f "${XDG_CONFIG_HOME}/mke2fs.conf" ]]
then
	configfile="${XDG_CONFIG_HOME}/mke2fs.conf"
elif [[ -n "${HOME}" && -f "${HOME}/.config/mke2fs.conf" ]]
then
	configfile="${HOME}/.config/mke2fs.conf"
elif [[ -n "${HOME}" && -f "${HOME}/mke2fs.conf" ]]
then
	configfile="${HOME}/mke2fs.conf"
elif [[ -n "${SUDO_HOME}" && -f "${SUDO_HOME}/.config/mke2fs.conf" ]]
then
	configfile="${SUDO_HOME}/.config/mke2fs.conf"
elif [[ -n "${SUDO_HOME}" && -f "${SUDO_HOME}/mke2fs.conf" ]]
then
	configfile="${SUDO_HOME}/mke2fs.conf"
else
	configfile=''
fi

if   [[ -n "${configfile}" ]]
then
	if   (( 4 <= USER_COLORTERM ))
	then
		echo 'Using configuration: '$'\e[1m'"${configfile}"$'\e[0m'
	else
		echo 'Using configuration: '"${configfile}"
	fi
	echo

	blockdevice=''
	auto='false'
	for opt in "$@"
	do
		case "${opt}" in
			--auto)
				auto='true'
			;;
			--no-auto)
				auto='false'
			;;
			-*n*)
				color='true'
			;;
			*)
				if [[ "${opt:0:1}" != '-' && -b "${opt}" ]]
				then
					blockdevice="${opt}"
				fi
		esac
	done

	if   [[ "${auto}" == 'true' && -n "${blockdevice}" ]]
	then
		partlabel="$(blkid -s LABEL -o value ${blockdevice})"

		for fhs in root boot home opt srv usr var varlib vartmp
		do
			if   [[ "${partlabel}" == "${fhs}" ]]
			then
				if   grep -E "${partlabel}[[:space:]]+=" "${configfile}" > /dev/null 2>&1
				then
					echo "Using usage type    : ${fhs}"
					MKE2FS_CONFIG="${configfile}" "$(basename ${0%-config})" -T "${partlabel}" -L "${partlabel}" $@
					exit $?
				else
					break
				fi
			fi
		done
	fi

	if   [[ "${color}" == 'true' ]] && (( 5 <= USER_COLORTERM ))
	then
		MKE2FS_CONFIG="${configfile}" "$(basename ${0%-config})" "$@" | sed -E -e "${color_filter}"
	else
		MKE2FS_CONFIG="${configfile}" "$(basename ${0%-config})" "$@"
		exit $?
	fi
else
	if   [[ "${color}" == 'true' ]] && (( 5 <= USER_COLORTERM ))
	then
		"$(basename ${0%-config})" "$@" | sed -E -e "${color_filter}"
	else
		"$(basename ${0%-config})" "$@"
		exit $?
	fi
fi
