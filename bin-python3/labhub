class GitHubLikeAPI(GenericAPI):
	def ep_gitignores(self):
		return get_API( self.api_ep + 'gitignore/templates' )
	def ep_licenses(self):
		return get_API( self.api_ep + 'licenses?per_page=100' )

	def ep_repos(self, repo):
		return get_API( self.api_ep + 'repos/' + repo )

	def ep_languages(self, repo):
		return get_API( self.api_ep + 'repos/' + repo + '/languages' )

	def ep_releases(self, repo):
		return get_API( self.api_ep + 'repos/' + repo + '/releases' )
	def ep_release(self, repo, tag):
		return get_API( self.api_ep + 'repos/' + repo + '/releases/tags/' + tag )
	def ep_tags(self, repo):
		return get_API( self.api_ep + 'repos/' + repo + '/git/refs/tags' )
	def ep_tag(self, repo, tag):
		return get_API( self.api_ep + 'repos/' + repo + '/git/refs/tags/' + tag )

	def gitignores(self):
		return json.loads( self.ep_gitignores() )

	def licenses(self):
		api_response = json.loads( self.ep_licenses() )

		response = []
		for license in api_response:
			response.append(
				{
					'key'  : license['key'] ,
					'name' : license['name'] ,
				}
			)
		return response

	def size(self, repo):
		api_response = json.loads( self.ep_repos(repo) )

		response = {
			'size' : api_response['size'] * 1024 ,
		}
		return response

	def releases(self, repo):
		api_response = json.loads( self.ep_releases(repo) )

		response = []
		for release in api_response:
			response.append(
				{
					'name'   : release['name'] ,
					'tag'    : release['tag_name'] ,
					'author' : release['author']['login'] ,
					'commit' : release['target_commitish'] ,
					'date'   : release['published_at'] ,
				}
			)
		return response

	def release(self, repo, tag):
		api_response = json.loads( self.ep_release(repo, tag) )

		assets = []
		for asset in api_response['assets']:
			assets.append(
				{
					'filename' : asset['name'] ,
					'size'     : asset['size'] ,
					'url'      : asset['browser_download_url'] ,
					'digest'   : asset['digest'] ,
				}
			)

		response = {
			'name'   : api_response['name'] ,
			'tag'    : api_response['tag_name'] ,
			'author' : api_response['author']['login'] ,
			'commit' : api_response['target_commitish'] ,
			'date'   : api_response['published_at'] ,
			'assets' : assets
		}
		return response

	def tags(self, repo):
		api_response = json.loads( self.ep_tags(repo) )

		response = []
		for tag in api_response:
			if 'tag' == tag['object']['type']:
				response.append(
					{
						'name'   : tag['ref'].removeprefix('refs/tags/') ,
						'type'   : 'annotated' ,
					}
				)
			else:
				response.append(
					{
						'name'   : tag['ref'].removeprefix('refs/tags/') ,
						'type'   : 'lightweight' ,
						'commit' : tag['object']['sha'] ,
					}
				)
		return response

	def tag(self, repo, tag):
		api_tag = json.loads( self.ep_tag(repo, tag) )

		if 'tag' == api_tag['object']['type']:
			api_commit = json.loads( get_API(api_tag['object']['url']) )

			response = {
				'name'     : api_tag['ref'].removeprefix('refs/tags/') ,
				'type'     : 'annotated' ,
				'tagger'   : '' ,
				'message'  : '' ,
				'verified' : '' ,
				'commit'   : api_commit['object']['sha'] ,
			}
		else:
			response = {
				'name'   : api_tag['ref'].removeprefix('refs/tags/') ,
				'type'   : 'lightweight' ,
				'commit' : api_tag['object']['sha'] ,
			}
		return response

class GitHubAPI(GitHubLikeAPI):
	def __init__(self, api_ep = 'https://api.github.com/'):
		self.api_ep = api_ep

	def ep_emojis(self):
		return get_API( self.api_ep + 'emojis' )

	def emojis(self):
		api_response = json.loads( self.ep_emojis() )

		response = []
		for emo in api_response.keys():
			char_text = api_response[emo].removesuffix('.png?v8').removeprefix('https://github.githubassets.com/images/icons/emoji/')
			if char_text.startswith('unicode/'):
				uni_chars = char_text.removeprefix('unicode/')
				uni_array = uni_chars.split('-')

				uni_str=str()
				for uni_char in uni_array:
					uni_str += chr( int(uni_char, base=16) )

				response.append(
					( emo, uni_array, uni_str )
				)
			else:
				response.append(
					( emo , char_text )
				)
		return response

	def info(self, repo):
		api_repo = json.loads( self.ep_repos(repo) )
		api_lang = json.loads( self.ep_languages(repo) )

		if api_repo['license'] == None:
			license = None
		else:
			license = api_repo['license']['name']

		response = {
			'id'             : api_repo['id'] ,
			'name'           : api_repo['full_name'] ,
			'homepage'       : api_repo['homepage'] ,
			'description'    : api_repo['description'] ,
			'topics'         : api_repo['topics'] ,
			'license'        : license ,
			'stars'          : api_repo['stargazers_count'] ,
			'forks'          : api_repo['forks_count'] ,
			'languages'      : api_lang ,
			'created'        : api_repo['created_at'] ,
			'updated'        : api_repo['updated_at'] ,
			'default_branch' : api_repo['default_branch'] ,
			'size'           : api_repo['size'] * 1024 ,
		}
		return response

	def stars(self, repo):
		api_response = json.loads( self.ep_repos(repo) )

		response = {
			'stars' : api_response['stargazers_count'] ,
		}
		return response


