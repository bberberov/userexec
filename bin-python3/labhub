class SourceForgeAPI(GenericAPI):
	def __init__(self, api_ep = 'https://sourceforge.net/rest/'):
		self.api_ep = api_ep

	def ep_repos(self, repo):
		# NOTE: '/p/' or '/u/' is part of the path
		return get_API( self.api_ep + repo )

	def ep_releases(self, repo):
		# NOTE: '/p/' or '/u/' is part of the path
		return get_API( self.api_ep + repo + '/files' )

	def info(self, repo):
		api_repo = json.loads( self.ep_repos(repo) )

		licenses = []
		languages = []
		topics = []
		for category in api_repo['categories']:
			if 0 < len(category):
				match category:
					case 'license':
						for licence in api_repo['categories']['license']:
							licenses.append(licence['fullname'])
					case 'language':
						for language in api_repo['categories']['language']:
							languages.append( ( language['fullname'], 0 ) )
					case 'topic':
						for topic in api_repo['categories']['topic']:
							topics.append( topic['fullname'] )

		topics += api_repo['labels']

		response = {
			'id'             : api_repo['_id'] ,
			'name'           : api_repo['name'] ,
			'homepage'       : api_repo['external_homepage'] ,
			'description'    : api_repo['summary'] ,
			'topics'         : topics ,
			'license'        : licenses ,
			'stars'          : 'N/A' ,
			'forks'          : 'N/A' ,
			'languages'      : languages ,
			'created'        : api_repo['creation_date'] ,
			'updated'        : 'N/A' ,
			'default_branch' : 'N/A' ,
			'size'           : 'N/A' ,
		}
		return response

